# Copy this file to backend/.env and fill in the values. Never commit backend/.env.
# Azure OpenAI v1 base URL (Foundry resource), ending in /openai/v1/
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# SQLite file for shared critical messages. Leave empty to use backend/data/scamguard.db.
SCAMGUARD_DB_PATH=
