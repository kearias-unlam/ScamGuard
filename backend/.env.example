# Copy this file to backend/.env and fill in the values. Never commit backend/.env.
# Azure OpenAI v1 base URL (Foundry resource), ending in /openai/v1/
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# SQLite file for shared critical messages. Leave empty to use backend/data/scamguard.db.
SCAMGUARD_DB_PATH=
# Shared secret for the session token sent by the frontend (Feature 9). Same value as SCAMGUARD_JWT_SECRET in the frontend .env.local.
SCAMGUARD_JWT_SECRET=
# Allowed frontend origins for CORS, comma-separated, without a trailing slash. Leave empty for http://localhost:3000.
# Example: http://localhost:3000,https://<your-app>.vercel.app
SCAMGUARD_FRONTEND_ORIGINS=
