# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Backend base URL (default http://localhost:8000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Auth.js (Feature 9). Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft Entra ID app registration (Azure portal > App registrations).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# common = personal and work or school accounts.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Shared with the backend: signs the session token sent to it. Same value as SCAMGUARD_JWT_SECRET in backend/.env.
SCAMGUARD_JWT_SECRET=
